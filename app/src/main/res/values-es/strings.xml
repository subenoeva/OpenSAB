    <string name="permission_status_granted">Concedido</string>
    <string name="permission_status_denied">Sin conceder</string>
    <string name="permission_status_unsupported">No disponible</string>
    <string name="permission_bluetooth_title">Bluetooth</string>
    <string name="permission_bluetooth_desc">Sin esto el escaneo no encuentra nada y no llega a haber conexión. Todo lo demás de la lista depende de ello.</string>
    <string name="permission_bluetooth_enabled_title">Bluetooth encendido</string>
    <string name="permission_bluetooth_enabled_desc">Ningún permiso enciende la radio. Es un interruptor del sistema, y con él apagado no hay nada que escanear ni a lo que conectarse.</string>
    <string name="permission_notification_access_title">Acceso a notificaciones</string>
    <string name="permission_notification_access_desc">La música, las llamadas, los mensajes y el guiado paso a paso llegan al cuadro por aquí. Sin esto, el cuadro se queda en blanco.</string>
    <string name="permission_battery_title">Batería sin restricciones</string>
    <string name="permission_battery_desc">Sin esto Android mata el servicio de conexión en segundo plano y la autoconexión deja de responder al dar contacto.</string>
    <string name="permission_overlay_title">Mostrar sobre otras apps</string>
    <string name="permission_overlay_desc">Sin esto Android bloquea el inicio del reproductor de música en segundo plano cuando el móvil está bloqueado en el bolsillo.</string>
    <string name="permission_notifications_title">Notificaciones</string>
    <string name="permission_notifications_desc">Sin esto el servicio de conexión sigue vivo sin nada visible que tocar, así que no hay vuelta a la app desde la barra de estado.</string>
    <string name="permission_location_weather_title">Ubicación aproximada</string>
    <string name="permission_location_weather_desc">Sin esto la entrada de meteorología del cuadro se queda vacía: una previsión hay que pedirla para algún sitio, y ese sitio sale de aquí.</string>
    <string name="permission_location_services_title">Ubicación encendida</string>
    <string name="permission_location_services_desc">Con la ubicación del sistema apagada la previsión no tiene desde dónde, por muy concedido que esté el permiso.</string>
    <string name="permission_microphone_title">Micrófono</string>
    <string name="permission_microphone_desc">Sin esto no se dictan respuestas desde el manillar. Las cuatro respuestas fijas siguen funcionando igual.</string>
    <string name="permission_contacts_title">Contactos</string>
    <string name="permission_contacts_desc">Para encontrar por su nombre a quien llamas. Solo se leen, nunca se modifican, y no salen del teléfono.</string>
    <string name="permission_place_calls_title">Realizar llamadas</string>
    <string name="permission_place_calls_desc">Para marcar desde el manillar. Sin él, la entrada de teléfono solo muestra una llamada que ya está en curso.</string>
    <string name="permission_answer_calls_title">Responder llamadas</string>
    <string name="permission_answer_calls_desc">Una reserva, para marcadores que publican una llamada sin los intents para actuar sobre ella. Hoy no depende de esto nada del cuadro.</string>
    <string name="permission_answer_calls_unsupported_desc">Las llamadas entrantes llegan como notificación CallStyle, que Android añadió en la versión 12. Este móvil es anterior, así que al cuadro no se le puede avisar de una llamada.</string>
    <string name="permission_send_sms_title">Enviar SMS</string>
    <string name="permission_send_sms_desc">Para redactar y enviar mensajes desde el manillar. Sin él, el menú de redacción de mensajes permanece cerrado.</string>

