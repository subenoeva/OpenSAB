    <!-- Permissions Screen -->
    <string name="permission_screen_title">Permissions</string>
    <string name="permission_intro_title">Nothing here is required</string>
    <string name="permission_intro_subtitle">This is everything OpenSAB can ask your phone for, and exactly what stops working without each one. Grant what you want, leave the rest, and carry on.</string>
    <string name="permission_intro_footnote">All of it can be changed later, from Settings.</string>
    <string name="permission_continue">Continue</string>

    <!-- Permissions Screen · summary -->
    <string name="permission_summary_count">%1$d/%2$d</string>
    <string name="permission_summary_blocking">Nothing will connect</string>
    <string name="permission_summary_blocking_desc">Bluetooth is how the motorcycle is found. Until it is both granted and turned on, the rest of this list has nothing to act on.</string>
    <string name="permission_summary_partial">Granted in part</string>
    <string name="permission_summary_partial_desc">Whatever is still missing costs only what its own row says, and nothing else.</string>
    <string name="permission_summary_all_granted">Everything granted</string>
    <string name="permission_summary_all_granted_desc">Nothing on this screen is standing in the way.</string>

    <!-- Permissions Screen · groups -->
    <string name="permission_group_essential">Essential</string>
    <string name="permission_group_essential_caption">Without these there is no connection of any kind</string>
    <string name="permission_group_optional">Features</string>
    <string name="permission_group_optional_caption">Each one costs only what its own row says</string>

    <!-- Permissions Screen · where a tap leads -->
    <string name="permission_action_runtime">Opens the Android dialog</string>
    <string name="permission_action_special">Opens a screen in Android settings</string>
    <string name="permission_action_toggle">Opens the Android switch</string>

    <!-- Permissions Screen · rows -->
    <string name="permission_status_granted">Granted</string>
    <string name="permission_status_denied">Not granted</string>
    <string name="permission_status_unsupported">Unavailable</string>
    <string name="permission_bluetooth_title">Bluetooth</string>
    <string name="permission_bluetooth_desc">Without it the scan finds nothing and no connection is ever made. Everything else on this list depends on this one.</string>
    <string name="permission_bluetooth_enabled_title">Bluetooth turned on</string>
    <string name="permission_bluetooth_enabled_desc">No permission turns the radio on. It is a system switch, and with it off there is nothing to scan and nothing to connect to.</string>
    <string name="permission_notification_access_title">Notification access</string>
    <string name="permission_notification_access_desc">Music, calls, messages and turn-by-turn all reach the cluster through here. Without it the cluster stays blank.</string>
    <string name="permission_battery_title">Unrestricted battery</string>
    <string name="permission_battery_desc">Without it Android kills the connection service in the background, and auto-connect stops answering when you turn the key.</string>
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_desc">Without it Android blocks starting your music player from the background when the phone is locked in your pocket.</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_desc">Without it the connection service keeps running with nothing visible to tap, so there is no way back into the app from the status bar.</string>
    <string name="permission_location_weather_title">Approximate location</string>
    <string name="permission_location_weather_desc">Without it the weather entry on the cluster stays empty: a forecast has to be asked for somewhere, and this is where that somewhere comes from.</string>
    <string name="permission_location_services_title">Location turned on</string>
    <string name="permission_location_services_desc">With the system location off the forecast has nowhere to be asked for, however granted the permission is.</string>
    <string name="permission_microphone_title">Microphone</string>
    <string name="permission_microphone_desc">Without it there is no dictating a reply from the handlebar. The four fixed replies keep working either way.</string>
    <string name="permission_contacts_title">Contacts</string>
    <string name="permission_contacts_desc">To find who you are calling by name. It is only read, never changed, and nothing leaves the phone.</string>
    <string name="permission_place_calls_title">Placing calls</string>
    <string name="permission_place_calls_desc">To dial from the handlebar. Without it the phone entry only shows a call that is already up.</string>
    <string name="permission_answer_calls_title">Answering calls</string>
    <string name="permission_answer_calls_desc">A spare, for dialers that publish a call without the intents to act on it. Nothing on the cluster depends on it today.</string>
    <string name="permission_answer_calls_unsupported_desc">Incoming calls arrive as a CallStyle notification, which Android added in version 12. This phone is older, so the cluster cannot be told about a call at all.</string>
    <string name="permission_send_sms_title">Send SMS</string>
    <string name="permission_send_sms_desc">To compose and send text messages from the handlebar. Without it the messages compose menu stays closed.</string>

