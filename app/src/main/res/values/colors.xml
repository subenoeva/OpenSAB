<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- What the window is painted with before Compose draws anything: the splash, and then the
         Activity the splash hands over to. Both read the same colour so the handover is not a
         flash of the wrong theme. It has a values-night twin; the launcher icon background below
         does not, because the launcher resolves it against its own configuration. -->
    <color name="splash_background">#FFFBFE</color>

    <!-- The mark is a thin neon line drawing. Near-black is what keeps it legible over any
         wallpaper, at any of the shapes a launcher may mask the icon into. -->
    <color name="ic_launcher_background">#0B1013</color>
</resources>
