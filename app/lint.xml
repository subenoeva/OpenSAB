<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Cluster strings intentionally use ASCII periods ('...') for compatibility with
      motorcycle instrument cluster firmware and byte budgeting.
      StringResourcesTest forbids XML entities like &#8230; in cluster strings.
    -->
    <issue id="TypographyEllipsis" severity="ignore" />

    <!--
      In Spanish, Unicode CLDR defines 'many' for numbers ending in millions.
      Speech hours (0..24) and temperature (-40..50) in OpenSAB never evaluate the 'many' rule.
    -->
    <issue id="MissingQuantity" severity="ignore" />

    <!--
      settings_permissions_summary formats '%1$d of %2$d granted'; it has two arguments
      and is not a single-parameter plural candidate.
    -->
    <issue id="PluralsCandidate" severity="ignore" />

    <!--
      allowBackup="false" is explicitly set to protect cryptographic keys and BLE bond state.
    -->
    <issue id="DataExtractionRules" severity="ignore" />
</lint>
